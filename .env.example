# Anthropic API key — required for the pipeline to run
ANTHROPIC_API_KEY=

# Optional: override the models used. Defaults are set in lib/anthropic.ts.
# ANTHROPIC_MODEL_STRONG=claude-opus-4-7
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Public base URL (used for shareable links). Leave empty in dev.
APP_BASE_URL=
