# Copy to .env.local and fill in real values. .env.local is gitignored.

# Required: Anthropic API key for the agent pipeline.
ANTHROPIC_API_KEY=

# Required (Phase 3a+): Supabase project credentials.
# Find these in Supabase dashboard → Project Settings → API.
# NEXT_PUBLIC_* values are bundled into the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
